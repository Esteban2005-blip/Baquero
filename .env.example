# Public build configuration only. Flutter reads --dart-define, not this file.
# Android emulator: http://10.0.2.2:5000/api
# Physical Android over USB: adb reverse tcp:5000 tcp:5000
# flutter run --dart-define=API_BASE_URL=http://127.0.0.1:5000/api
# Production: flutter build apk --release --dart-define=APP_ENV=production --dart-define=API_BASE_URL=https://your-host/api
